{
  "ConnectionStrings": {
    // Azure SQL Database (oferta gratuita, serverless): servidor washtrack-devtech-16129-db, base washtrack, region Canada Central.
    // La contrasena NO se guarda aqui: se toma de la variable de entorno WASHTRACK_DB_PASSWORD
