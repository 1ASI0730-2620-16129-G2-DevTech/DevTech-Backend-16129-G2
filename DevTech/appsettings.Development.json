    // Se pausa tras 1 hora sin uso; la primera conexion despues de la pausa puede tardar hasta ~1 minuto.
    "DefaultConnection": "Server=tcp:washtrack-devtech-16129-db.database.windows.net,1433;Initial Catalog=washtrack;Persist Security Info=False;User ID=adminDevTech;Password=%WASHTRACK_DB_PASSWORD%;MultipleActiveResultSets=False;Encrypt=True;TrustServerCertificate=False;Connection Timeout=60;"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  }
}
