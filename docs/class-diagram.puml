@startuml
' WashTrack Backend Platform - Consolidated Bounded Context Architecture

skinparam classAttributeIconSize 0

' ==============================================================================
' BOUNDED CONTEXT: ORDER MANAGEMENT
' ==============================================================================
package "OrderManagement" {

  package "Interfaces.REST" {
    class OrdersController {
      +CreateOrder(CreateOrderResource, CancellationToken) : Task<ActionResult>
      +GetOrderById(int, CancellationToken) : Task<ActionResult>
      +GetOrdersByCustomerId(string, CancellationToken) : Task<ActionResult>
    }

    package "Resources" {
      class OrderResource <<resource>> {
        +int Id
        +string CustomerId
        +decimal TotalAmount
        +string Status
      }
      class CreateOrderResource <<resource>> {
        +string CustomerId
        +decimal TotalAmount
      }
    }

    package "Transform" {
      class OrderResourceFromEntityAssembler <<assembler>> {
        +ToResourceFromEntity(Order) : OrderResource
      }
      class CreateOrderCommandFromResourceAssembler <<assembler>> {
        +ToCommandFromResource(CreateOrderResource) : CreateOrderCommand
      }
      class ActionResultFromCreateOrderResultAssembler <<assembler>> {
        +ToActionResultFromCreateOrderResult(Result<Order, CreateOrderError>, ControllerBase, IStringLocalizer<SharedResource>, string) : ActionResult
      }
    }
  }

  package "Domain.Model" {
    package "ValueObjects" {
      class CustomerIdVO <<value-object>> {
        +string Value
      }
      enum OrderStatus <<value-object>> {
        Created
        InLaundryProcess
        ReadyForDelivery
        Completed
        Cancelled
      }
    }

    package "Commands" {
      class CreateOrderCommand <<command>> {
        +CustomerIdVO CustomerId
        +decimal TotalAmount
      }
    }

    package "Queries" {
      class GetOrderByIdQuery <<query>> {
        +int Id
      }
    }

    package "Aggregates" {
      class Order <<aggregate>> {
        +int Id
        +CustomerIdVO CustomerId
        +decimal TotalAmount
        +OrderStatus Status
        +Order(CreateOrderCommand)
        +UpdateStatus(OrderStatus) : void
      }
    }
  }

  package "Application" {
    package "Errors" {
      enum CreateOrderError <<error>> {
        InvalidCustomer
        InvalidAmount
        UnexpectedError
      }
    }

    package "Services" {
      interface IOrderCommandService <<application-service>> {
        +Handle(CreateOrderCommand, CancellationToken) : Task<Result<Order, CreateOrderError>>
      }
      interface IOrderQueryService <<application-service>> {
        +Handle(GetOrderByIdQuery, CancellationToken) : Task<Order?>
      }
    }

    package "Internal.CommandServices" {
      class OrderCommandService <<service>> {
        +Handle(CreateOrderCommand, CancellationToken) : Task<Result<Order, CreateOrderError>>
      }
    }

    package "Internal.QueryServices" {
      class OrderQueryService <<service>> {
        +Handle(GetOrderByIdQuery, CancellationToken) : Task<Order?>
      }
    }
  }

  package "Infrastructure.Persistence.EFC.Repositories" {
    class OrderRepository <<repository>> {
      +FindByCustomerIdAsync(CustomerIdVO, CancellationToken) : Task<IEnumerable<Order>>
    }
  }
}

' ==============================================================================
' BOUNDED CONTEXT: LAUNDRY OPERATIONS
' ==============================================================================
package "LaundryOperations" {

  package "Interfaces.REST" {
    class LaundryOrdersController {
      +GetLaundryOrderById(int, CancellationToken) : Task<ActionResult>
      +GetAllLaundryOrders(CancellationToken) : Task<ActionResult>
      +ClassifyLaundryOrder(int, CancellationToken) : Task<ActionResult>
      +AssignWashingCycle(int, AssignWashingCycleResource, CancellationToken) : Task<ActionResult>
      +AssignResource(int, AssignResourceResource, CancellationToken) : Task<ActionResult>
      +AdvanceStage(int, CancellationToken) : Task<ActionResult>
      +PrioritizeLaundryOrder(int, PrioritizeLaundryOrderResource, CancellationToken) : Task<ActionResult>
    }

    class LaundryResourcesController {
      +GetResourcesByLaundryId(int, CancellationToken) : Task<ActionResult>
      +ReleaseResource(int, CancellationToken) : Task<ActionResult>
    }

    class WashingCyclesController {
      +GetAllWashingCycles(CancellationToken) : Task<ActionResult>
    }

    package "Resources" {
      class LaundryOrderResource <<resource>> {
        +int Id
        +int OrderId
        +string CurrentStage
        +string Priority
        +int? WashingCycleId
        +int? ResourceId
        +DateTimeOffset? ExpectedCompletion
        +bool IsReady
      }
      class AssignWashingCycleResource <<resource>> {
        +int WashingCycleId
      }
      class AssignResourceResource <<resource>> {
        +int ResourceId
      }
      class PrioritizeLaundryOrderResource <<resource>> {
        +string Priority
      }
      class LaundryResourceResource <<resource>> {
        +int Id
        +int LaundryId
        +string Name
        +string Status
        +int Capacity
      }
      class WashingCycleResource <<resource>> {
        +int Id
        +string Name
        +int DurationMinutes
        +string CompatibleType
      }
    }

    package "Transform" {
      class LaundryOrderResourceFromEntityAssembler <<assembler>> {
        +ToResourceFromEntity(LaundryOrder) : LaundryOrderResource
      }
      class LaundryResourceResourceFromEntityAssembler <<assembler>> {
        +ToResourceFromEntity(LaundryResource) : LaundryResourceResource
      }
      class WashingCycleResourceFromEntityAssembler <<assembler>> {
        +ToResourceFromEntity(WashingCycle) : WashingCycleResource
      }
      class AssignWashingCycleCommandFromResourceAssembler <<assembler>> {
        +ToCommandFromResource(int, AssignWashingCycleResource) : AssignWashingCycleCommand
      }
      class AssignResourceCommandFromResourceAssembler <<assembler>> {
        +ToCommandFromResource(int, AssignResourceResource) : AssignResourceCommand
      }
      class PrioritizeLaundryOrderCommandFromResourceAssembler <<assembler>> {
        +ToCommandFromResource(int, PrioritizeLaundryOrderResource) : PrioritizeLaundryOrderCommand
      }
      class ActionResultFromLaundryOrderResultAssembler <<assembler>> {
        +ToActionResultFromLaundryOrderResult(Result<LaundryOrder, LaundryOrderError>, ControllerBase) : ActionResult
      }
      class ActionResultFromLaundryResourceResultAssembler <<assembler>> {
        +ToActionResultFromLaundryResourceResult(Result<LaundryResource, LaundryResourceError>, ControllerBase) : ActionResult
      }
    }
  }

  package "Domain.Model" {
    package "ValueObjects" {
      class LaundryOrderId <<value-object>> {
        +int Value
        +LaundryOrderId(int)
      }
      class LaundryResourceId <<value-object>> {
        +int Value
        +LaundryResourceId(int)
      }
      class WashingCycleId <<value-object>> {
        +int Value
        +WashingCycleId(int)
      }
      class LaundryId <<value-object>> {
        +int Value
        +LaundryId(int)
      }
      enum EProcessingStage <<value-object>> {
        Reception
        Classification
        Washing
        DryingIroning
        Packaging
        Ready
      }
      enum EPriority <<value-object>> {
        Normal
        Vip
      }
      enum EResourceStatus <<value-object>> {
        Available
        Busy
        Maintenance
      }
    }

    package "Commands" {
      class ReceiveLaundryOrderCommand <<command>> {
        +int OrderId
        +EPriority Priority
      }
      class ClassifyLaundryOrderCommand <<command>> {
        +LaundryOrderId LaundryOrderId
      }
      class AssignWashingCycleCommand <<command>> {
        +LaundryOrderId LaundryOrderId
        +WashingCycleId WashingCycleId
      }
      class AssignResourceCommand <<command>> {
        +LaundryOrderId LaundryOrderId
        +LaundryResourceId ResourceId
      }
      class AdvanceStageCommand <<command>> {
        +LaundryOrderId LaundryOrderId
      }
      class PrioritizeLaundryOrderCommand <<command>> {
        +LaundryOrderId LaundryOrderId
        +EPriority Priority
      }
      class ReleaseResourceCommand <<command>> {
        +LaundryResourceId ResourceId
      }
      class SyncResourceStatusCommand <<command>> {
        +LaundryResourceId ResourceId
        +EResourceStatus Status
      }
    }

    package "Queries" {
      class GetLaundryOrderByIdQuery <<query>> {
        +LaundryOrderId LaundryOrderId
      }
      class GetAllLaundryOrdersQuery <<query>> {
      }
      class GetAllLaundryResourcesByLaundryIdQuery <<query>> {
        +LaundryId LaundryId
      }
      class GetAllWashingCyclesQuery <<query>> {
      }
    }

    package "Aggregates" {
      class LaundryOrder <<aggregate>> {
        +LaundryOrderId Id
        +int OrderId
        +EProcessingStage CurrentStage
        +EPriority Priority
        +int? WashingCycleId
        +int? ResourceId
        +DateTimeOffset? ExpectedCompletion
        +bool IsReady
        +LaundryOrder(LaundryOrderId, int, EProcessingStage, EPriority, int?, int?, DateTimeOffset?, bool)
        +LaundryOrder(int, EPriority)
        +LaundryOrder(ReceiveLaundryOrderCommand)
        +Classify() : void
        +AssignWashingCycle(WashingCycleId) : void
        +AssignResource(LaundryResourceId) : void
        +AdvanceStage() : void
        +Prioritize(EPriority) : void
      }

      class LaundryResource <<aggregate>> {
        +LaundryResourceId Id
        +LaundryId LaundryId
        +string Name
        +EResourceStatus Status
        +int Capacity
        +bool IsAvailable
        +LaundryResource(LaundryResourceId, LaundryId, string, EResourceStatus, int)
        +LaundryResource(LaundryId, string, int)
        +LaundryResource(int, string, int)
        +Assign() : void
        +Release() : void
        +ApplyMonitoredStatus(EResourceStatus) : void
      }
    }

    package "Entities" {
      class WashingCycle <<entity>> {
        +WashingCycleId Id
        +string Name
        +int DurationMinutes
        +string CompatibleType
        +IsCompatible(string) : bool
      }
    }
  }

  package "Application" {
    package "Errors" {
      enum LaundryOrderError <<error>> {
        LaundryOrderNotFound
        OrderAlreadyReceived
        OrderAlreadyReady
        WashingCycleAndResourceRequired
        WashingCycleNotFound
        ResourceNotFound
        InvalidStageTransition
        UnexpectedError
      }
      enum LaundryResourceError <<error>> {
        ResourceNotFound
        ResourceNotAvailable
        ResourceNotBusy
        InvalidResourceStatus
        UnexpectedError
      }
    }

    package "Services" {
      interface ILaundryOrderCommandService <<application-service>> {
        +Handle(ReceiveLaundryOrderCommand, CancellationToken) : Task<Result<LaundryOrder, LaundryOrderError>>
        +Handle(ClassifyLaundryOrderCommand, CancellationToken) : Task<Result<LaundryOrder, LaundryOrderError>>
        +Handle(AssignWashingCycleCommand, CancellationToken) : Task<Result<LaundryOrder, LaundryOrderError>>
        +Handle(AssignResourceCommand, CancellationToken) : Task<Result<LaundryOrder, LaundryOrderError>>
        +Handle(AdvanceStageCommand, CancellationToken) : Task<Result<LaundryOrder, LaundryOrderError>>
        +Handle(PrioritizeLaundryOrderCommand, CancellationToken) : Task<Result<LaundryOrder, LaundryOrderError>>
      }
      interface ILaundryResourceCommandService <<application-service>> {
        +Handle(ReleaseResourceCommand, CancellationToken) : Task<Result<LaundryResource, LaundryResourceError>>
        +Handle(SyncResourceStatusCommand, CancellationToken) : Task<Result<LaundryResource, LaundryResourceError>>
      }
      interface ILaundryOperationsQueryService <<application-service>> {
        +Handle(GetLaundryOrderByIdQuery, CancellationToken) : Task<LaundryOrder?>
        +Handle(GetAllLaundryOrdersQuery, CancellationToken) : Task<IEnumerable<LaundryOrder>>
        +Handle(GetAllLaundryResourcesByLaundryIdQuery, CancellationToken) : Task<IEnumerable<LaundryResource>>
        +Handle(GetAllWashingCyclesQuery, CancellationToken) : Task<IEnumerable<WashingCycle>>
      }
    }

    package "Outbound" {
      interface IResourceMonitoringFacade <<port>> {
        +GetResourceStatusAsync(LaundryResourceId, CancellationToken) : Task<EResourceStatus>
      }
    }

    package "Internal.CommandServices" {
      class LaundryOrderCommandService <<service>> {
        +Handle(ReceiveLaundryOrderCommand, CancellationToken) : Task<Result<LaundryOrder, LaundryOrderError>>
        +Handle(ClassifyLaundryOrderCommand, CancellationToken) : Task<Result<LaundryOrder, LaundryOrderError>>
        +Handle(AssignWashingCycleCommand, CancellationToken) : Task<Result<LaundryOrder, LaundryOrderError>>
        +Handle(AssignResourceCommand, CancellationToken) : Task<Result<LaundryOrder, LaundryOrderError>>
        +Handle(AdvanceStageCommand, CancellationToken) : Task<Result<LaundryOrder, LaundryOrderError>>
        +Handle(PrioritizeLaundryOrderCommand, CancellationToken) : Task<Result<LaundryOrder, LaundryOrderError>>
      }
      class LaundryResourceCommandService <<service>> {
        +Handle(ReleaseResourceCommand, CancellationToken) : Task<Result<LaundryResource, LaundryResourceError>>
        +Handle(SyncResourceStatusCommand, CancellationToken) : Task<Result<LaundryResource, LaundryResourceError>>
      }
    }

    package "Internal.QueryServices" {
      class LaundryOperationsQueryService <<service>> {
        +Handle(GetLaundryOrderByIdQuery, CancellationToken) : Task<LaundryOrder?>
        +Handle(GetAllLaundryOrdersQuery, CancellationToken) : Task<IEnumerable<LaundryOrder>>
        +Handle(GetAllLaundryResourcesByLaundryIdQuery, CancellationToken) : Task<IEnumerable<LaundryResource>>
        +Handle(GetAllWashingCyclesQuery, CancellationToken) : Task<IEnumerable<WashingCycle>>
      }
    }
  }

  package "Infrastructure.Persistence.EFC.Repositories" {
    class LaundryOrderRepository <<repository>> {
      +FindByOrderIdAsync(int, CancellationToken) : Task<LaundryOrder?>
    }
    class LaundryResourceRepository <<repository>> {
      +FindByLaundryIdAsync(LaundryId, CancellationToken) : Task<IEnumerable<LaundryResource>>
    }
    class WashingCycleRepository <<repository>> {
    }
  }

  package "Infrastructure.ExternalServices.IoT" {
    class IotGatewayClient <<external-client>> {
      +GetTelemetryAsync(int, CancellationToken) : Task<SensorTelemetryPayload>
    }
    class SensorTelemetryPayload <<payload>> {
      +int ResourceId
      +string State
      +DateTimeOffset ReadAt
    }
    class ResourceMonitoringACL <<acl>> {
      +GetResourceStatusAsync(LaundryResourceId, CancellationToken) : Task<EResourceStatus>
      -Translate(SensorTelemetryPayload) : EResourceStatus
    }
  }
}

