      +FindByOrderIdAsync(Guid, CancellationToken) : Task<Tracking?>
    }

    interface INotificationRepository <<repository>> {
      +FindByRecipientIdAsync(Guid, CancellationToken) : Task<IEnumerable<Notification>>
    }
  }

  package "Infrastructure.Persistence.EFC.Configuration" {
    class AppDbContext <<db-context>> {
      +OnConfiguring(DbContextOptionsBuilder) : void
      +OnModelCreating(ModelBuilder) : void
      --
      +orders
      +laundry_orders
      +laundry_resources
      +washing_cycles
      +customers
      +pickups_deliveries
      +tracking_notifications
      +payments
    }

    package "Services" {
      interface ITrackingCommandService <<application-service>> {
        +Handle(RecordStatusChangeCommand, CancellationToken) : Task<Result<Tracking, TrackingError>>
      }

      interface INotificationCommandService <<application-service>> {
        +Handle(SendNotificationCommand, CancellationToken) : Task<Result<Notification, NotificationError>>
      }

      interface ITrackingQueryService <<application-service>> {
        +Handle(GetTrackingByOrderIdQuery, CancellationToken) : Task<Tracking?>
      }

      interface INotificationQueryService <<application-service>> {
        +Handle(GetAllNotificationsByRecipientIdQuery, CancellationToken) : Task<IEnumerable<Notification>>
      }
    }

    package "Outbound" {
      interface IEmailService <<port>> {
        +SendAsync(string, string, string, CancellationToken) : Task
      }
    }

    package "Internal.CommandServices" {
      class TrackingCommandService <<service>> {
        +Handle(RecordStatusChangeCommand, CancellationToken) : Task<Result<Tracking, TrackingError>>
      }

      class NotificationCommandService <<service>> {
        +Handle(SendNotificationCommand, CancellationToken) : Task<Result<Notification, NotificationError>>
      }
    }

    package "Internal.QueryServices" {
      class TrackingQueryService <<service>> {
        +Handle(GetTrackingByOrderIdQuery, CancellationToken) : Task<Tracking?>
      }

      class NotificationQueryService <<service>> {
        +Handle(GetAllNotificationsByRecipientIdQuery, CancellationToken) : Task<IEnumerable<Notification>>
      }
    }

    package "Internal.EventHandlers" {
      class StageAdvancedEventHandler <<event-handler>> {
        +Handle(StageAdvanced, CancellationToken) : Task
      }

      class StatusHistoryRecordedEventHandler <<event-handler>> {
        +Handle(StatusHistoryRecorded, CancellationToken) : Task
      }
    }
  }

' Controllers to Application Services
OrdersController --> IOrderCommandService : uses
OrdersController --> IOrderQueryService : uses
LaundryOrdersController --> ILaundryOrderCommandService : uses
LaundryOrdersController --> ILaundryOperationsQueryService : uses
LaundryResourcesController --> ILaundryResourceCommandService : uses
LaundryResourcesController --> ILaundryOperationsQueryService : uses
WashingCyclesController --> ILaundryOperationsQueryService : uses
CustomersController --> ICustomerCommandService : uses
CustomersController --> ICustomerQueryService : uses
PickupsDeliveriesController --> IPickupDeliveryCommandService : uses
PickupsDeliveriesController --> IPickupDeliveryQueryService : uses
TrackingNotificationsController --> ITrackingNotificationCommandService : uses
TrackingNotificationsController --> ITrackingNotificationQueryService : uses
PaymentsController --> IPaymentCommandService : uses
PaymentsController --> IPaymentQueryService : uses

' Service Implementations
OrderCommandService ..|> IOrderCommandService
OrderQueryService ..|> IOrderQueryService
LaundryOrderCommandService ..|> ILaundryOrderCommandService
LaundryResourceCommandService ..|> ILaundryResourceCommandService
LaundryOperationsQueryService ..|> ILaundryOperationsQueryService
CustomerCommandService ..|> ICustomerCommandService
CustomerQueryService ..|> ICustomerQueryService
PickupDeliveryCommandService ..|> IPickupDeliveryCommandService
PickupDeliveryQueryService ..|> IPickupDeliveryQueryService
TrackingNotificationCommandService ..|> ITrackingNotificationCommandService
TrackingNotificationQueryService ..|> ITrackingNotificationQueryService
PaymentCommandService ..|> IPaymentCommandService
PaymentQueryService ..|> IPaymentQueryService

' Laundry Operations: anticorruption layer (IoT monitoring)
LaundryResourceCommandService --> IResourceMonitoringFacade : uses
ResourceMonitoringACL ..|> IResourceMonitoringFacade
ResourceMonitoringACL --> IotGatewayClient : uses
ResourceMonitoringACL ..> SensorTelemetryPayload : translates
IotGatewayClient --> SensorTelemetryPayload : returns

' Aggregates Value Objects ownership
Order --> CustomerIdVO : owns
Order --> OrderStatus : owns
LaundryOrder --> LaundryOrderId : owns
LaundryOrder --> EProcessingStage : owns
LaundryOrder --> EPriority : owns
LaundryResource --> LaundryResourceId : owns
LaundryResource --> LaundryId : references
LaundryResource --> EResourceStatus : owns
WashingCycle --> WashingCycleId : owns
Customer --> EmailAddress : owns
Customer --> PhoneNumber : owns
PickupDelivery --> DeliveryAddress : owns
PickupDelivery --> ServiceType : owns
PickupDelivery --> PickupDeliveryStatus : owns
TrackingNotification --> NotificationType : owns
PaymentTransaction --> TransactionId : owns
PaymentTransaction --> PaymentStatus : owns

' Repositories & Base Infrastructure
OrderRepository --|> BaseRepository
LaundryOrderRepository --|> BaseRepository
LaundryResourceRepository --|> BaseRepository
WashingCycleRepository --|> BaseRepository
CustomerRepository --|> BaseRepository
PickupDeliveryRepository --|> BaseRepository
TrackingNotificationRepository --|> BaseRepository
PaymentRepository --|> BaseRepository
BaseRepository ..|> IBaseRepository
UnitOfWork ..|> IUnitOfWork

' DbContext Entity Mappings
AppDbContext --> Order : maps
AppDbContext --> LaundryOrder : maps
AppDbContext --> LaundryResource : maps
AppDbContext --> WashingCycle : maps
AppDbContext --> Customer : maps
AppDbContext --> PickupDelivery : maps
AppDbContext --> TrackingNotification : maps
AppDbContext --> PaymentTransaction : maps

@enduml
