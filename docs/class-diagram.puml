@startuml
' WashTrack Platform - Backend Class Diagram
' RESTful API: C# / ASP.NET Core + Entity Framework Core (DDD, layered per bounded context)
' Bounded Contexts: IAM, CustomerBusinessManagement, OrderManagement, LaundryOperations,
'                   SubscriptionPayment, TrackingNotifications
' Cross-context references are by identifier only (Guid), never by object.

skinparam classAttributeIconSize 0
hide empty members

package "Shared" {

  package "Application" {

    package "Model" {
      abstract class "Result<TValue, TError>" as ResultT <<result>> {
        +IsSuccess : bool
        +IsFailure : bool
        +Map<TNext>(Func<TValue, TNext>) : Result<TNext, TError>
        +Fold<TResult>(Func<TValue, TResult>, Func<TError, TResult>) : TResult
        +Match(Action<TValue>, Action<TError>) : void
      }
    }

    package "Internal.EventHandlers" {
      interface IEventHandler<TEvent> <<event-handler>> {
        +Handle(TEvent, CancellationToken) : Task
      }
    }
  }

  package "Domain" {

    package "Model" {

      package "Aggregates" {
        interface IAggregateRoot <<aggregate>> {
          +DomainEvents : IReadOnlyCollection<IEvent>
          +ClearDomainEvents() : void
        }

        package "Internal" {
          abstract class AggregateRoot<TId> <<aggregate>> {
            +TId Id
            #AddDomainEvent(IEvent) : void
          }
        }
      }

      package "Entities" {
        interface IAuditableEntity <<auditable>> {
          +DateTimeOffset? CreatedAt
          +DateTimeOffset? UpdatedAt
        }
      }

      package "Errors" {
        class Error <<error>> {
          +string Code
          +string Message
        }
      }

      package "Events" {
        interface IEvent <<event>> {
          +Guid EventId
          +DateTimeOffset OccurredAt
        }
      }

      package "ValueObjects" {
        interface IEntityId <<value-object>> {
          +Guid Value
        }
      }
    }

    package "Repositories" {
      interface IBaseRepository<TEntity> <<repository>> {
        +AddAsync(TEntity, CancellationToken) : Task
        +FindByIdAsync(IEntityId, CancellationToken) : Task<TEntity?>
        +Update(TEntity) : void
        +Remove(TEntity) : void
        +ListAsync(CancellationToken) : Task<IEnumerable<TEntity>>
      }

      interface IUnitOfWork <<unit-of-work>> {
        +CompleteAsync(CancellationToken) : Task
      }
    }
  }

  package "Infrastructure" {

    package "Interfaces.AspNetCore" {
      package "Configuration" {
        class KebabCaseRouteNamingConvention <<convention>> {
          +Apply(ControllerModel) : void
        }

        package "Extensions" {
          class ServiceCollectionExtensions <<extension>> {
            +{static} AddSharedInfrastructure(IServiceCollection) : IServiceCollection
          }
        }
      }
    }

    package "Persistence.EntityFrameworkCore" {

      package "Configuration" {
        class AppDbContext <<db-context>> {
          +OnConfiguring(DbContextOptionsBuilder) : void
          +OnModelCreating(ModelBuilder) : void
          --
          +users, customers, laundries
          +orders, garment_items
          +laundry_orders, washing_cycles, laundry_resources
          +subscription_plans, subscriptions, payments
          +tracking, status_history, notifications
          +value converters for entity ids / value objects
        }

        package "Extensions" {
          class ModelBuilderExtensions <<extension>> {
            +{static} UseSnakeCaseNamingConvention(ModelBuilder) : void
          }
        }

        package "ValueConverters" {
          class "EntityIdValueConverter<TId>" as EntityIdValueConverter <<value-converter>> {
            +ConvertToProvider(TId) : Guid
            +ConvertFromProvider(Guid) : TId
          }
        }
      }

      package "Interceptors" {
        class AuditableEntityInterceptor <<interceptor>> {
          +SavingChanges(DbContextEventData, InterceptionResult<int>) : InterceptionResult<int>
          +SavingChangesAsync(DbContextEventData, InterceptionResult<int>, CancellationToken) : ValueTask<InterceptionResult<int>>
        }

        class DispatchDomainEventsInterceptor <<interceptor>> {
          +SavedChangesAsync(SaveChangesCompletedEventData, int, CancellationToken) : ValueTask<int>
        }
      }

      package "Repositories" {
        class BaseRepository<TEntity> <<repository>> {
          +AddAsync(TEntity, CancellationToken) : Task
          +FindByIdAsync(IEntityId, CancellationToken) : Task<TEntity?>
          +Update(TEntity) : void
          +Remove(TEntity) : void
          +ListAsync(CancellationToken) : Task<IEnumerable<TEntity>>
        }

        class UnitOfWork <<unit-of-work>> {
          +CompleteAsync(CancellationToken) : Task
        }
      }
    }
  }

  package "Interfaces.Rest" {
    package "ProblemDetails" {
      class ProblemDetailsFactory <<factory>> {
        +Create(string, int, string) : ProblemDetails
      }
    }
  }

  package "Resources" {
    package "Errors" {
      class ErrorMessages <<resource-file>> {
        +{static} ResourceManager
        ' ErrorMessages.es.resx -> traducciones al español
      }
    }

    class CommonMessages <<resource-file>> {
      +{static} ResourceManager
    }
  }
}

' Shared relationships
AggregateRoot ..|> IAggregateRoot : implements
AggregateRoot ..> IEvent : collects
AggregateRoot ..> IEntityId : identified by

BaseRepository ..|> IBaseRepository : implements
UnitOfWork ..|> IUnitOfWork : implements
BaseRepository --> AppDbContext : uses
UnitOfWork --> AppDbContext : uses

AppDbContext ..> AuditableEntityInterceptor : uses
AppDbContext ..> DispatchDomainEventsInterceptor : uses
AppDbContext ..> IAuditableEntity : timestamps
AppDbContext ..> EntityIdValueConverter : maps ids
AppDbContext ..> ModelBuilderExtensions : uses
DispatchDomainEventsInterceptor ..> IEventHandler : dispatches to
DispatchDomainEventsInterceptor ..> IAggregateRoot : reads events
EntityIdValueConverter ..> IEntityId : converts

ProblemDetailsFactory ..> Error : maps
ProblemDetailsFactory ..> ErrorMessages : localizes
ProblemDetailsFactory ..> CommonMessages : localizes

note right of AppDbContext
  EF Core mappings:
  - snake_case tables / columns
  - id value converters (Guid)
  - one table per aggregate and child entity
end note

note right of AggregateRoot
  Todos los aggregate roots extienden
  AggregateRoot<TId> del Shared Kernel.
end note

